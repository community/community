# 1. Inicializar el repositorio Git local
git init

# 2. Agregar todos los archivos al seguimiento
git add .

# 3. Crear el primer commit
git commit -m "Initial commit - EM Servicios Eléctricos App"

# 4. Cambiar la rama principal a 'main'
git branch -M main

# 5. Vincular tu repositorio de GitHub (reemplaza con la URL de tu repositorio creado en github.com)
git remote add origin https://github.com/TU_USUARIO/TU_REPOSITORIO.git

# 6. Subir el código a GitHub
git push -u origin main
